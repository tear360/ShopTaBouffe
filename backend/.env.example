# Delivro backend — variables d'environnement (copier vers .env)

# Port HTTP
PORT=3000

# URL publique (callbacks OAuth + Socket.IO)
# dev Android : http://10.0.2.2:3000
PUBLIC_URL=http://10.0.2.2:3000

# Schéma du deep link de retour (app Android)
APP_REDIRECT_SCHEME=shoptabouffe

# Secret JWT — aléatoire au 1er lancement si absent (persisté dans la DB)
# JWT_SECRET=change-me

# Code fournisseur (insensible à la casse, trim)
ADMIN_CODE=SUPPLIER-2026

# Active POST /api/auth/demo ("true" | "false")
ALLOW_DEMO_LOGIN=true

# OAuth Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
