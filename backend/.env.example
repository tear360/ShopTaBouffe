# Delivro backend — variables d'environnement (copier vers .env)

# Port HTTP
PORT=3000

# URL publique (callbacks OAuth + Socket.IO) — DOMAINE DE PRODUCTION
PUBLIC_URL=https://chorizo.dpdns.org

# Schéma du deep link de retour (app Android)
APP_REDIRECT_SCHEME=shoptabouffe

# Secret JWT — aléatoire au 1er lancement si absent (persisté dans la DB)
# JWT_SECRET=change-me

# Code fournisseur (insensible à la casse, trim)
ADMIN_CODE=82dha92jdao8210dajod821JS0

# Connexion par nom supprimée : la création de comptes invités est désactivée.
# Les comptes démo existants conservent leur session et sont invités à finaliser
# leur compte via POST /api/auth/upgrade (données conservées).
ALLOW_DEMO_LOGIN=false

# OAuth GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail — liens « mot de passe oublié » (obligatoire pour l'envoi réel)
# Exemple : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Facultatif : adresse d'expédition (par défaut = SMTP_USER)
MAIL_FROM=
# SMTP sans authentification (serveur local) : SMTP_NO_AUTH=1
SMTP_NO_AUTH=
